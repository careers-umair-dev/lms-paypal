# Required
MONGO_URI=mongodb://127.0.0.1:27017/lms
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug              # error | warn | info | debug
SYNC_INDEXES=false          # set true once to recreate indexes after a schema change
PAYMENT_MODE=mock            # mock | paypal | stripe
# Required only when PAYMENT_MODE=paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox   # sandbox | live
PAYPAL_WEBHOOK_ID=           # from PayPal developer dashboard
# Required only when PAYMENT_MODE=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Premium LMS <no-reply@lms.local>"
# Private video storage (files served only through short-lived signed links)
MEDIA_DIR=./private-media
MEDIA_SECRET=                # optional; falls back to JWT_SECRET
# Seed script credentials (npm run seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
