VITE_PAYPAL_CLIENT_ID=   # PayPal PUBLIC client id only. Never put the secret here.
VITE_API_URL=            # leave empty in dev (Vite proxy); set to https://api.yourdomain.com/api in production
VITE_STRIPE_ENABLED=false    # set true only if server has STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET

VITE_PAYMENT_MODE=mock        # mock | paypal | stripe
